# Register an Amp server OAuth client with this exact callback before production use.
AMP_OAUTH_CLIENT_ID=
AMP_OAUTH_CLIENT_SECRET=
AMP_OAUTH_REDIRECT_URI=https://collector.example.com/auth/callback

# Random secret of at least 32 characters, used to encrypt session cookies.
COLLECTOR_SESSION_SECRET=

# Comma-separated Amp OIDC subject IDs; empty denies all notes access.
# This is NOT the platform app-owner/admin permission for the comment widget.
COLLECTOR_ALLOWED_USER_IDS=

# Optional dedicated machine credential for Shortcuts (/share only).
# Setting this disables legacy password/key sharing; coordinate client migration first.
COLLECTOR_SHARE_TOKEN=

# First-rollout compatibility for existing /share bearer/key clients only.
# Accepted only when COLLECTOR_SHARE_TOKEN is unset; never browser sign-in.
COLLECTOR_PASSWORD=

# Where the SQLite database lives. Default: data/collector.db
DATABASE_PATH=data/collector.db

# Required in production so form posts (login, share target) pass origin checks.
ORIGIN=https://collector.example.com
